# TRUTHLENS Configuration Environment
APP_ENV=development
APP_NAME=TRUTHLENS
DEBUG=true

# Database Configuration (Defaults to local SQLite fallback)
DATABASE_URL=sqlite:///./data/truthlens.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/truthlens

# Storage Configuration
UPLOAD_DIR=./data/uploads
SAMPLE_DIR=./data/samples
REFERENCE_DOCS_DIR=./data/reference_documents
MAX_UPLOAD_SIZE_MB=15

# Vision Model Configuration
# TruthLens operates in a hybrid dual-engine architecture:
# 1. Local Forensic Vision Engine: Uses Pillow, NumPy, and SciPy for local spatial decomposition,
#    color distribution, texture frequency, and feature detection. Works completely offline with zero API keys.
# 2. Hosted Neural Vision Model (Optional upgrade for deep visual descriptions & transcription):
#    To enable Google Gemini Vision:
#    Set GEMINI_API_KEY (or GOOGLE_API_KEY or LLM_API_KEY). Model defaults to gemini-2.5-flash.
ENABLE_EXTERNAL_LLM=false
GEMINI_API_KEY=
# VISION_MODEL=gemini-2.5-flash
# Or for OpenAI / Local Ollama VLM (e.g. LLaVA / Qwen2-VL):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# External Evidence Search Engines
# By default, TruthLens utilizes live Wikipedia / Wikimedia and DuckDuckGo HTML search without API keys.
# To enable commercial high-throughput search APIs:
ENABLE_EXTERNAL_WEB_SEARCH=true
# TAVILY_API_KEY=
# SERPER_API_KEY=
